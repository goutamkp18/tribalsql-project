# ==============================================================================
# TribalSQL Backend Environment Configuration (Render / Production / Local)
# ==============================================================================

# Groq Cloud API Key (Get at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq AI Models
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Hindsight Cloud Semantic Agent Memory Engine (https://hindsight.vectorize.io)
HINDSIGHT_API_KEY=hsk_your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=novamart-prod-db

# NovaMart PostgreSQL Database Connection URL (Supabase or PostgreSQL 14+)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Allowed Frontend URL for CORS (Comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173,https://tribalsql.vercel.app

# Server Port (Render sets $PORT dynamically; default is 8000 locally)
PORT=8000

