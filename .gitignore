# ==============================================================================
# TribalSQL — Git Ignore Rules
# ==============================================================================

# Environment variable files and secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Python virtual environment & caches
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node & Frontend dependencies and builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Temporary local database files
*.db
*.sqlite3
!novamart.db.example

# Editor, OS & Temporary files
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp
*.swo

# Screenshots and test output artifacts
screenshots/
*.png
*.jpg
*.jpeg

